# Default local configuration for the API.
#
# api/.env is created from this file automatically the first time the API
# starts, so a freshly downloaded copy needs no manual setup step.
#
# DB_USER / DB_PASSWORD match the MySQL account that api/database/schema.sql
# creates when it is imported with an administrative login. Assessment 3 needs
# the full CRUD cycle, so that account is granted SELECT, INSERT, UPDATE and
# DELETE (still no DDL rights and no GRANT OPTION). Change these values only if
# you use a different MySQL account.
DB_HOST=localhost
DB_PORT=3306
DB_USER=charity_app
DB_PASSWORD=change_me
DB_NAME=charityevents_db
PORT=3000
# Extra origins allowed by CORS. The Angular development servers (4200 and
# 4300) and the plain static server (5500) are always allowed automatically; add
# your cPanel domain here when you deploy, for example:
# CORS_ORIGINS=https://yourusername.scu.edu.au
CORS_ORIGINS=
# Timeout in milliseconds for the external Open-Meteo weather API.
WEATHER_TIMEOUT_MS=6000
